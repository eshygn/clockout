# Every key is optional. With none set, Clockout runs fully in mock mode
# (recorded AI responses + a PayPal stand-in that behaves like the sandbox).

# --- Bryntum (needed for `npm install`, not at runtime) ---
# The email you registered a Bryntum trial with. scripts/bryntum-auth.sh turns it
# into a login for npm.bryntum.com and writes it to ~/.npmrc (never this repo).
BRYNTUM_EMAIL=

# --- PayPal sandbox (Payouts) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Sandbox PERSONAL accounts (developer.paypal.com > Testing Tools > Sandbox Accounts).
# SANDBOX_RECEIVER_<FIRSTNAME> pays that worker; the rest of the crew is spread across
# every receiver set here, so live payouts settle as SUCCESS.
SANDBOX_RECEIVER_SAM=
SANDBOX_RECEIVER_AVA=
# Fallback single receiver, used only when no SANDBOX_RECEIVER_* is set.
PAYPAL_SANDBOX_RECEIVER_EMAIL=

# --- AI (Gemini API free tier, via the Vercel AI SDK) ---
GOOGLE_GENERATIVE_AI_API_KEY=
# Leave empty to use the newest Gemini Flash model. Falls back to the next Flash models the API lists, then recorded responses.
AI_MODEL=
# Local guard for the free tier (calls per minute). Over it, recorded responses are used.
AI_RPM=12

# --- App ---
# Defaults to USD for sandbox safety.
CLOCKOUT_CURRENCY=USD
# Set to 1 to ignore any keys above and run in mock mode.
CLOCKOUT_FORCE_MOCK=
# Not used by Clockout (kept for parity with the hackathon environment).
AG_GRID_LICENSE_KEY=
